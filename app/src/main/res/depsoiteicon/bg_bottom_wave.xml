<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="360dp"
    android:height="96dp"
    android:viewportWidth="360"
    android:viewportHeight="96">

    <path
        android:name="wavePath"
        android:fillType="evenOdd"
        android:pathData="
            M0,0
            L0,48
            C80,96 280,0 360,48
            L360,0
            Z"
        android:fillColor="#ffffff"
    />

    <!-- 2. Overlay a vertical gradient on top of that path -->
    <group android:name="gradientGroup">
        <path
            android:fillType="evenOdd"
            android:fillColor="@drawable/bg_bottom_wave_gradient"/>
    </group>
</vector>
