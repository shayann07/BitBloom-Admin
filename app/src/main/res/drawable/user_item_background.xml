<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1) Simulated drop-shadow via a radial gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.7"
                android:endColor="#00378AFC"
                android:gradientRadius="40dp"
                android:startColor="#21378AFC"
                android:type="radial" />
        </shape>
    </item>

    <!-- 2) Main frosted-glass overlay -->
    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="90"
                android:centerColor="#66FFFFFF"
                android:endColor="#1AFFFFFF"
                android:startColor="#1AFFFFFF"
                android:type="linear"
                android:useLevel="false" />
        </shape>
    </item>


</layer-list>
